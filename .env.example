# Public site URL (no trailing slash). Required for canonical URLs, OG tags, sitemap, robots.
# On Vercel, VERCEL_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Display name for metadata and structured data
NEXT_PUBLIC_SITE_NAME=Shift Latam

# Directus (Newsroom + RAG articles)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# Token estático de servicio con permisos de lectura sobre news_articles.
# Si no está seteado, el código intenta login con DIRECTUS_ADMIN_EMAIL/PASSWORD.
DIRECTUS_STATIC_TOKEN=
DIRECTUS_ADMIN_EMAIL=admin@shiftlatam.agency
DIRECTUS_ADMIN_PASSWORD=admin

# SMTP for /api/contact (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hubspot — Service Key / Private App con scopes:
#   crm.objects.contacts.read + write
#   crm.objects.owners.read
#   crm.objects.notes.write
# Sin estos vars seteados, el form sigue mandando email pero NO crea
# Contact en HubSpot (degradación graceful — logueamos a console, no
# rompemos la request del usuario).
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=

# Shifty agent → Cerebro Gateway (OAI compat)
# Bearer key registrada en peaje_apps_keys con app_id='shift-pn-landing'.
# Pedírsela a Jred (no se commitea). En prod: setear en la plataforma de
# deploy como env var del proyecto.
CEREBRO_API_KEY=
CEREBRO_BASE_URL=https://shift-cerebro-production.up.railway.app
# Modelo via OpenRouter. Default: gemini-3.5-flash ($1.50/M in, $9.00/M out).
# Reasoning es obligatorio en este modelo — el extra de tokens internos compra
# guardrails y flow de captura más confiables. Costo ~$0.012/turno; con cap
# de $50/mes da ~4K turns/mes (suficiente para una landing).
AGENT_MODEL_ID=google/gemini-3.5-flash

# OpenRouter API key — solo para generar embeddings del RAG de Shifty.
# No se usa para chat (eso sigue en Cerebro). Los embeddings son ~$0.02 por ingest completo.
OPENROUTER_API_KEY=

# Activar RAG dinámico para Shifty (on | off). Default off para deploy seguro.
AGENT_RAG=off
