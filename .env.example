# Public site URL (no trailing slash). Required for canonical URLs, OG tags, sitemap, robots.
# On Vercel, VERCEL_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Display name for metadata and structured data
NEXT_PUBLIC_SITE_NAME=Shift Latam

# SMTP for /api/contact (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hubspot
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
HUBSPOT_REGION=

# Shifty agent → Cerebro Gateway (OAI compat)
# Bearer key registrada en peaje_apps_keys con app_id='shift-pn-landing'.
# Pedírsela a Jred (no se commitea). En Netlify: project env var.
CEREBRO_API_KEY=
CEREBRO_BASE_URL=https://shift-cerebro-production.up.railway.app
# Modelo via OpenRouter. Default: gemini-2.5-flash ($0.30/M in, $2.50/M out, sin
# reasoning obligatorio). Para subir calidad y costo: google/gemini-3.5-flash
# ($1.50 / $9.00 con reasoning forzado — ~10x más caro por turno).
AGENT_MODEL_ID=google/gemini-2.5-flash
